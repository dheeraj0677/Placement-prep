# -----------------------------------------------------------------------------
# PlacementPrep Radar - Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these from https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# Supabase Public Configuration (used in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Site URL for OAuth callbacks (defaults to localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
